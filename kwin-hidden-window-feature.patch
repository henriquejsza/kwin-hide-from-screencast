+
+namespace KWin
+{
+
+class Window;
+
+/**
+ * @brief Input filter for interacting with hidden windows (excludeFromCapture).
+ *
+ * When activated (F12 key), this filter:
+ * - Freezes the visible cursor position
+ * - Redirects mouse/keyboard input to the hidden window
+ * - Acts as if a virtual cursor is moving inside the hidden window
+ */
+class KWIN_EXPORT HiddenWindowInputFilter : public QObject, public InputEventFilter
+{
+    Q_OBJECT
+public:
+    HiddenWindowInputFilter();
+    ~HiddenWindowInputFilter() override;
+
+    bool pointerMotion(PointerMotionEvent *event) override;
+    bool pointerButton(PointerButtonEvent *event) override;
+    bool pointerAxis(PointerAxisEvent *event) override;
+    bool keyboardKey(KeyboardKeyEvent *event) override;
+
+    bool isActive() const
+    {
+        return m_active;
+    }
+    Window *targetWindow() const
+    {
+        return m_targetWindow;
+    }
+
+public Q_SLOTS:
+    void setTargetWindow(Window *window);
+
+private:
+    void activate();
+    void deactivate();
+    void sendKeyEventToWindow(quint32 key, bool pressed);
+    Window *findHiddenWindow(bool includeMinimized = false) const;
+
+    bool m_active = false;
+    QPointF m_frozenCursorPos; // Position where cursor appears frozen
+    QPointF m_hiddenCursorPos; // Virtual cursor position in hidden window
+    Window *m_targetWindow = nullptr;
+    Qt::MouseButtons m_pressedButtons;
+    bool m_isDragging = false; // Window is being dragged
+    bool m_originalSkipTaskbar = false; // Original state to restore on deactivate
+    bool m_originalSkipSwitcher = false; // Original state to restore on deactivate
+};
+
+} // namespace KWin
