+    if (m_respectsWindowCaptureExclusion) {
+        // Walk up the item hierarchy to find the WindowItem ancestor
+        Item *current = item;
+        bool foundWindowItem = false;
+        while (current) {
+            if (auto windowItem = qobject_cast<WindowItem *>(current)) {
+                foundWindowItem = true;
+                if (auto window = windowItem->window()) {
+                    if (window->excludeFromCapture()) {
+                        return false;
+                    }
+                }
+                break; // Found WindowItem, no need to continue
+            }
+            current = current->parentItem();
+        }
+        // If this item is not part of any WindowItem (e.g., overlay items like virtual cursor),
+        // check the item's own excludeFromCapture property
+        if (!foundWindowItem && item->excludeFromCapture()) {
+            return false;
+        }
+    }
     return std::ranges::none_of(m_exclusiveViews, [item](RenderView *view) {
         return view->shouldRenderItem(item);
     });
 }
 
