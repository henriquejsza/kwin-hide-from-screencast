+void WorkspaceScene::showVirtualCursor(const QPointF &pos)
+{
+    if (!m_virtualCursorItem) {
+        m_virtualCursorItem = std::make_unique<CursorItem>(m_overlayItem.get());
+        m_virtualCursorItem->setZ(2); // Above normal cursor
+        m_virtualCursorItem->setExcludeFromCapture(true); // Hide from screen recordings
+    }
+    m_virtualCursorItem->setPosition(pos);
+    m_virtualCursorItem->setVisible(true);
+    qDebug() << "WorkspaceScene: Virtual cursor shown at" << pos;
+}
+
+void WorkspaceScene::hideVirtualCursor()
+{
+    if (m_virtualCursorItem) {
+        m_virtualCursorItem->setVisible(false);
+        qDebug() << "WorkspaceScene: Virtual cursor hidden";
+    }
+}
+
+void WorkspaceScene::updateVirtualCursorPosition(const QPointF &pos)
+{
+    if (m_virtualCursorItem && m_virtualCursorItem->isVisible()) {
