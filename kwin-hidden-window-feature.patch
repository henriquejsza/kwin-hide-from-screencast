+#include "hiddenwindowinputfilter.h"
+#include "compositor.h"
+#include "cursor.h"
+#include "input_event.h"
+#include "pointer_input.h"
+#include "scene/workspacescene.h"
+#include "wayland/seat.h"
+#include "wayland_server.h"
+#include "window.h"
+#include "workspace.h"
+
+#include <QDebug>
+#include <linux/input-event-codes.h>
+
+namespace KWin
+{
+
+// Activation key: F12
+static const Qt::Key ACTIVATION_KEY = Qt::Key_F12;
+static const quint32 ACTIVATION_SCANCODE = KEY_F12;
+
+HiddenWindowInputFilter::HiddenWindowInputFilter()
+    : InputEventFilter(InputFilterOrder::LockScreen) // Must be before GlobalShortcut to intercept F12
+{
+}
+
+HiddenWindowInputFilter::~HiddenWindowInputFilter()
+{
+    if (m_active) {
+        deactivate();
+    }
+}
+
+void HiddenWindowInputFilter::setTargetWindow(Window *window)
+{
+    if (m_targetWindow == window) {
+        return;
+    }
+
+    if (m_active && m_targetWindow != window) {
+        deactivate();
+    }
+
+    m_targetWindow = window;
+
+    if (window) {
+        connect(window, &Window::closed, this, [this]() {
+            if (m_active) {
+                deactivate();
+            }
+            m_targetWindow = nullptr;
+        });
+    }
+}
+
+void HiddenWindowInputFilter::activate()
+{
+    if (m_active || !m_targetWindow) {
+        return;
+    }
+
+    m_active = true;
+    m_isDragging = false;
+
+    // Lock the cursor at its current position (also freezes cursor shape)
+    input()->pointer()->setInternalLocked(true);
+
+    // Store current cursor position (will appear "frozen")
+    m_frozenCursorPos = Cursors::self()->mouse()->pos();
+
+    // Initialize hidden cursor at center of target window
+    m_hiddenCursorPos = m_targetWindow->frameGeometry().center();
+
+    m_pressedButtons = Qt::NoButton;
+
+    // Hide window from dock and Alt+Tab
+    // Hide window from dock and Alt+Tab is now handled by Window::setExcludeFromCapture
+
+    qDebug() << "HiddenWindowInputFilter: Activating... Target:" << (m_targetWindow ? m_targetWindow->caption() : "None");
+
+    // Show virtual cursor at hidden position
+    if (auto scene = qobject_cast<WorkspaceScene *>(Compositor::self()->scene())) {
+        scene->showVirtualCursor(m_hiddenCursorPos);
+    }
+
+    // Establish pointer focus on the hidden window ONCE with proper transformation
+    if (waylandServer() && waylandServer()->seat()) {
+        auto surface = m_targetWindow->surface();
+        if (surface) {
+            SeatInterface *seat = waylandServer()->seat();
+            // Use the window's input transformation matrix for proper coordinate mapping
+            seat->notifyPointerEnter(surface, m_hiddenCursorPos, m_targetWindow->inputTransformation());
+            seat->notifyPointerFrame();
+        }
+    }
+
+    // Force repaint to fix blur issue when entering hidden mode
+    Compositor::self()->scene()->addRepaintFull();
+
+    qDebug() << "HiddenWindowInputFilter: Activated for window" << m_targetWindow->caption();
+    qDebug() << "HiddenWindowInputFilter: Frozen cursor at" << m_frozenCursorPos;
+    qDebug() << "HiddenWindowInputFilter: Hidden cursor at" << m_hiddenCursorPos;
+}
+
+void HiddenWindowInputFilter::deactivate()
+{
+    if (!m_active) {
+        return;
+    }
+
+    m_active = false;
+
+    // Hide virtual cursor first
+    if (auto scene = qobject_cast<WorkspaceScene *>(Compositor::self()->scene())) {
+        scene->hideVirtualCursor();
+    }
+
+    m_pressedButtons = Qt::NoButton;
+
+    // Restore window visibility in dock and Alt+Tab
+    // Window visibility restoration is handled by setExcludeFromCapture toggle
+
+    // Clear pointer focus from the hidden window
+    if (waylandServer() && waylandServer()->seat()) {
+        waylandServer()->seat()->notifyPointerLeave();
+    }
+
+    // Unlock the cursor - this allows normal input handling to resume
+    input()->pointer()->setInternalLocked(false);
+
+    // Warp pointer to the frozen position
+    input()->pointer()->warp(m_frozenCursorPos);
+
+    // FORCE Seat update to sync with reality
+    // PointerInputRedirection might silently skip the update if it thinks focus didn't change,
+    // but the Seat was manually cleared above. We must restore it manually.
+    if (waylandServer() && waylandServer()->seat()) {
+        Window *foundWindow = nullptr;
+        const auto &stacking = workspace()->stackingOrder();
+        // Iterate form top to bottom to find the top-most window under cursor
+        for (int i = stacking.count() - 1; i >= 0; --i) {
+            Window *w = stacking.at(i);
+            if (w->isDeleted() || !w->isShown()) {
+                continue;
+            }
+            if (w->frameGeometry().contains(m_frozenCursorPos)) {
+                foundWindow = w;
+                break;
+            }
+        }
+
+        if (foundWindow && foundWindow->surface()) {
+            waylandServer()->seat()->notifyPointerEnter(foundWindow->surface(), m_frozenCursorPos, foundWindow->inputTransformation());
+            waylandServer()->seat()->notifyPointerFrame();
+        }
+    }
+
+    qDebug() << "HiddenWindowInputFilter: Deactivated, warped to" << m_frozenCursorPos;
+}
+
+bool HiddenWindowInputFilter::keyboardKey(KeyboardKeyEvent *event)
+{
+    // Alt+D shortcut: GLOBAL toggle minimize/restore for hidden windows
+    // Works regardless of whether m_active is true or not!
+    if (event->key == Qt::Key_D && (event->modifiers & Qt::AltModifier) && event->state == KeyboardKeyState::Pressed) {
+
+        // Find any hidden window (including minimized ones)
+        Window *hiddenWindow = findHiddenWindow(true /* includeMinimized */);
+
+        if (hiddenWindow) {
+            if (hiddenWindow->isMinimized()) {
+                // Unminimize (restore) the window
+                hiddenWindow->setMinimized(false);
+                // FORCE activation to steal focus from other apps (like Chrome)
+                workspace()->activateWindow(hiddenWindow);
+                qDebug() << "HiddenWindowInputFilter: Alt+D - Restored and ACTIVATED hidden window";
+            } else {
+                // Minimize the window
+                hiddenWindow->setMinimized(true);
+                qDebug() << "HiddenWindowInputFilter: Alt+D - Minimized hidden window";
+            }
+            return true; // Consume the event
+        }
+    }
+
+    // Check for activation key (F12) - TOGGLE mode
+    if (event->nativeScanCode == ACTIVATION_SCANCODE || event->key == ACTIVATION_KEY) {
+        // Only react to Pressed events (ignore Repeated and Released for toggle)
+        if (event->state == KeyboardKeyState::Pressed) {
+            if (!m_active) {
+                // ACTIVATE: Find a window with excludeFromCapture enabled
+                // Now includes minimized windows - they will be restored when activated
+                if (!m_targetWindow) {
+                    Window *found = findHiddenWindow(true /* includeMinimized */);
+                    if (found) {
+                        setTargetWindow(found);
+                    }
+                }
+
+                if (m_targetWindow) {
+                    // If window is minimized, restore it first
+                    if (m_targetWindow->isMinimized()) {
+                        m_targetWindow->setMinimized(false);
+                        qDebug() << "HiddenWindowInputFilter: Restored minimized window before activation";
+                    }
+                    qDebug() << "HiddenWindowInputFilter: TOGGLE ON";
+                    activate();
+                }
+            } else {
+                // DEACTIVATE: Toggle off
+                qDebug() << "HiddenWindowInputFilter: TOGGLE OFF";
+                deactivate();
+            }
+            return true; // Consume the key event
+        }
+
+        // Consume Repeated and Released events when active (ignore them for toggle)
+        if (m_active) {
+            return true;
+        }
+    }
+
+    // When active, forward OTHER keyboard events to target window (not F12 or Alt+D)
+    if (m_active && m_targetWindow) {
+        sendKeyEventToWindow(event->nativeScanCode, event->state == KeyboardKeyState::Pressed);
+        return true; // Consume the event
+    }
+
+    return false; // Let other filters handle it
+}
+
+bool HiddenWindowInputFilter::pointerMotion(PointerMotionEvent *event)
+{
+    if (!m_active || !m_targetWindow) {
+        return false;
+    }
+
+    // Update hidden cursor position with the delta
+    m_hiddenCursorPos += event->delta;
+
+    // If dragging, move the window and update cursor position
+    if (m_isDragging) {
+        // Move window by delta
+        QPointF newPos = m_targetWindow->pos() + event->delta;
+        m_targetWindow->move(newPos);
+
+        // Update virtual cursor position to follow
+        if (auto scene = qobject_cast<WorkspaceScene *>(Compositor::self()->scene())) {
+            scene->updateVirtualCursorPosition(m_hiddenCursorPos);
+        }
+        return true;
+    }
+
+    // Clamp to window bounds (when not dragging)
+    const QRectF windowRect = m_targetWindow->frameGeometry();
+    m_hiddenCursorPos.setX(qBound(windowRect.left(), m_hiddenCursorPos.x(), windowRect.right()));
+    m_hiddenCursorPos.setY(qBound(windowRect.top(), m_hiddenCursorPos.y(), windowRect.bottom()));
+
+    // Update virtual cursor position on screen
+    if (auto scene = qobject_cast<WorkspaceScene *>(Compositor::self()->scene())) {
+        scene->updateVirtualCursorPosition(m_hiddenCursorPos);
+    }
+
+    // Send pointer motion to the hidden window (focus was established in activate())
+    if (waylandServer() && waylandServer()->seat()) {
+        SeatInterface *seat = waylandServer()->seat();
+        seat->setTimestamp(event->timestamp);
+        seat->notifyPointerMotion(m_hiddenCursorPos);
+        seat->notifyPointerFrame();
+    }
+
+    return true; // Consume the event - cursor stays frozen
+}
+
+bool HiddenWindowInputFilter::pointerButton(PointerButtonEvent *event)
+{
+    if (!m_active || !m_targetWindow) {
+        return false;
+    }
+
+    // Update button state
+    if (event->state == PointerButtonState::Pressed) {
+        m_pressedButtons |= event->button;
+
+        // Check if this is a left button press on the decoration (title bar)
+        // Decoration is the area between frame geometry and client geometry
+        if (event->button == Qt::LeftButton) {
+            const QRectF frameRect = m_targetWindow->frameGeometry();
+            const QRectF clientRect = m_targetWindow->clientGeometry();
+
+            // Check if click is in frame but not in client area (i.e., decoration)
+            if (frameRect.contains(m_hiddenCursorPos) && !clientRect.contains(m_hiddenCursorPos)) {
+                // Start window drag
+                m_isDragging = true;
+                qDebug() << "HiddenWindowInputFilter: Started window drag at" << m_hiddenCursorPos;
+                return true; // Don't send button to client, we're dragging
+            }
+        }
+    } else {
+        m_pressedButtons &= ~event->button;
+
+        // Check if this is left button release while dragging
+        if (event->button == Qt::LeftButton && m_isDragging) {
+            m_isDragging = false;
+            qDebug() << "HiddenWindowInputFilter: Ended window drag";
+            return true;
+        }
+    }
+
+    // If dragging, don't forward button events to client
+    if (m_isDragging) {
+        return true;
+    }
+
+    // Forward the button event via Wayland (focus was established in activate())
+    if (waylandServer() && waylandServer()->seat()) {
+        SeatInterface *seat = waylandServer()->seat();
+        seat->setTimestamp(event->timestamp);
+        seat->notifyPointerButton(event->nativeButton, event->state);
+        seat->notifyPointerFrame();
+    }
+
+    return true;
+}
+
+bool HiddenWindowInputFilter::pointerAxis(PointerAxisEvent *event)
+{
+    if (!m_active || !m_targetWindow) {
+        return false;
+    }
+
+    // Forward scroll to hidden window (focus was established in activate())
+    if (waylandServer() && waylandServer()->seat()) {
+        SeatInterface *seat = waylandServer()->seat();
+        seat->setTimestamp(event->timestamp);
+        seat->notifyPointerAxis(
+            event->orientation,
+            event->delta,
+            event->deltaV120,
+            event->source,
+            event->inverted);
+        seat->notifyPointerFrame();
+    }
+
+    return true;
+}
+
+// sendPointerEventToWindow is no longer needed - pointer events are sent directly
+// in the respective handler methods with proper focus management
+
+void HiddenWindowInputFilter::sendKeyEventToWindow(quint32 key, bool pressed)
+{
+    if (!m_targetWindow || !waylandServer() || !waylandServer()->seat()) {
+        return;
+    }
+
+    auto surface = m_targetWindow->surface();
+    if (!surface) {
+        return;
+    }
+
+    SeatInterface *seat = waylandServer()->seat();
+
+    // Ensure keyboard focus is on the hidden window
+    seat->setFocusedKeyboardSurface(surface);
+    // Use 0 as serial since this is a synthetic event
+    seat->notifyKeyboardKey(key, pressed ? KeyboardKeyState::Pressed : KeyboardKeyState::Released, 0);
+}
+
+Window *HiddenWindowInputFilter::findHiddenWindow(bool includeMinimized) const
+{
+    const auto windows = workspace()->windows();
+    for (Window *w : windows) {
+        // excludeFromCapture() is the primary identifier for our target window
+        if (!w->excludeFromCapture()) {
+            continue;
+        }
+
+        if (includeMinimized) {
+            // Be aggressive: if it exists and hasn't been deleted, it's our window.
+            // Even if KWin thinks it's hidden (e.g. on another desktop), we want to find it.
+            if (!w->isDeleted()) {
+                qDebug() << "HiddenWindowInputFilter: Found candidate" << w->caption()
+                         << "minimized:" << w->isMinimized()
+                         << "hidden:" << w->isHidden()
+                         << "hiddenByShowDesktop:" << w->isHiddenByShowDesktop();
+                return w;
+            }
+        } else {
+            // Original behavior: use isShown()
+            if (w->isShown()) {
+                return w;
+            }
+        }
+    }
+    return nullptr;
+}
+
+} // namespace KWin
+
+#include "moc_hiddenwindowinputfilter.cpp"
