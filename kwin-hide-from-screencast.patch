+void Window::setExcludeFromCapture(bool newExcludeFromCapture)
+{
+    if (m_excludeFromCapture == newExcludeFromCapture) {
+        return;
+    }
+
+    m_excludeFromCapture = newExcludeFromCapture;
+
+    for (auto window : std::as_const(m_transients)) {
